{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix NewWebPage",
  "buildCommand": "npm run build --prefix NewWebPage",
  "outputDirectory": "NewWebPage/dist",
  "rewrites": [
    {
      "source": "/test",
      "destination": "/test/index.html"
    },
    {
      "source": "/test/(.*)",
      "destination": "/test/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // COCOBI 인터랙티브 사이트: Worker 코드 없이 Vite 빌드 결과(dist)만 정적 파일로 배포
  // 기존 Kigle 사이트가 있던 kg-deploy1 Worker 를 이 사이트로 교체함 (2026-10-09)
  // 이전 Kigle 버전: 17a6874a-2f45-4f57-a452-0f2f467da3c7 (wrangler rollback 으로 복구 가능)
  "name": "kg-deploy1",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": true,
  // 방문 분석: /api/track(수집), /api/stats·/stats(비밀번호 보호 분석 페이지)만 Worker 가 처리
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/stats", "/stats/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cocobi-analytics",
      "database_id": "d0706a7e-07ed-4135-ad81-7b06e3e50629",
      "migrations_dir": "worker/migrations"
    }
  ]
}

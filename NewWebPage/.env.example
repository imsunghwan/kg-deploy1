# ─────────────────────────────────────────────────────────────
#  비밀 설정 예시 — 이 파일을 복사해 같은 폴더에 `.env` 로 만들고 값을 채우세요.
#  (.env 는 git 에 올라가지 않습니다)
#
#  채운 뒤 이 폴더에서:
#    npm run secrets      → .env 의 값을 Cloudflare(kg-deploy1) 비밀 설정에 한 번에 올림
#    npx wrangler dev     → 내 컴퓨터에서 시험할 때도 이 값을 사용
#  비워 둔 항목은 올리지 않으니(기존 값 유지) 필요한 것만 채우면 됩니다.
# ─────────────────────────────────────────────────────────────

# OpenAI API 키 (https://platform.openai.com/api-keys) — 챗봇 모델 gpt-5.6-terra 호출용
OPENAI_API_KEY=

# 챗봇 관리자 페이지(/admin) 비밀번호 — 아이디는 아무거나
ADMIN_PASSWORD=

# ── 메일 알림 (대화가 시작되면 내 메일로) — Gmail SMTP ──
# Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호 에서 만든 16자리 (띄어쓰기 있어도 됨)
SMTP_USER=
SMTP_PASS=
# 알림을 받을 주소 (비워 두면 SMTP_USER 로 받음)
NOTIFY_TO=
# 기본값: smtp.gmail.com / 465 (바꿀 때만 주석 해제)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
